{
  "name": "@feliz/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker: SQS consumer for newsletter/email/background processing. Skeleton only until Phase 6 (Newsletter MVP).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@feliz/config": "workspace:*",
    "@feliz/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
