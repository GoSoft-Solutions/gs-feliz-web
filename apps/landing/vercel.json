{
  "cleanUrls": true,
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/news",
      "destination": "https://portal.danielcorral.com.mx/news"
    },
    {
      "source": "/news/:path*",
      "destination": "https://portal.danielcorral.com.mx/news/:path*"
