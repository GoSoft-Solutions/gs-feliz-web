# FELIZ Platform — environment variables
#
# Copy this file to .env and fill in real values for local development.
# Variables marked "(future)" are documented for upcoming phases but are
# NOT required yet — the app will run without them (see packages/config).

# --- Core runtime (required) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database (required) ---
# Matches the credentials in docker-compose.yml for local dev.
DATABASE_URL="postgresql://feliz:feliz@localhost:5432/feliz_dev?schema=public"

# --- HTTP / security (required) ---
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Integrations: ManyChat (required from Phase 3 onward) ---
# Shared secret ManyChat sends as X-API-Key on
# POST /api/v1/integrations/manychat/contacts
MANYCHAT_API_KEY=

# --- Future: Payments — Stripe (Phase 8, not required yet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Future: Sessions — Google Calendar/Meet (Phase 10, not required yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Future: Newsletter — AWS SES/SQS (Phase 6, not required yet) ---
AWS_REGION=us-east-1
SES_FROM_EMAIL=
SQS_QUEUE_URL=

# --- Future: Authentication (Phase 7, not required yet) ---
JWT_SECRET=
